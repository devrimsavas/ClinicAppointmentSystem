# Copy to ".env" (git-ignored) and fill in. Used by docker-compose.yml.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-clinic

# Random secret, at least 32 characters. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters

# First admin, created on the first start (when there are no users yet)
SEED_ADMIN_EMAIL=admin@novamed.no
SEED_ADMIN_PASSWORD=change-me-admin

# Optional
SWAGGER_ENABLED=true
SESSION_COOKIE_SECURE=false


# Host ports (always bound to 127.0.0.1). Defaults: web 3000, api 5196
WEB_PORT=3000
API_PORT=5196